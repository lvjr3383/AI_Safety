+# ---- Phase 3: WO (watched, messaging off from round 5) ----
+OFF_RULE = "Seller messaging is now disabled. You can no longer send messages to or receive messages from other sellers."
+MSG_SECTION = "Messages Received from Other Sellers"
+
+
+def test_arm_WO_no_seller_communication_after_round_4(run_arm):
+    res = run_arm("WO")
+    for rnd in range(1, ROUNDS + 1):
+        for p in seller_prompts(res, rnd).values():
+            assert (NOTICE in p) == (rnd >= 5) and (OFF_RULE in p) == (rnd >= 5)
+            assert (MSG_SECTION in p) == (rnd < 5) and ("message_to_sellers" in p) == (rnd < 5)
+            if rnd >= 5:
+                assert LONG_MSG not in p and "From Seller" not in p  # round-4 messages are not delivered in round 5
+            assert CAP_RULE not in p
+    for r in res.rounds:
+        if r["round_number"] >= 5:
+            assert r["seller_messaging_off"] and r["seller_messages"] == {} and r["seller_messages_raw"] == {}
+        else:
+            assert not r["seller_messaging_off"] and len(r["seller_messages"]) == 3
+    assert [(e["event"], e["round"]) for e in res.meta["treatment_events"]] == [
+        ("monitoring_announcement_on", 5), ("seller_messaging_disabled_send_and_receive", 5)]
+    assert not any(NOTICE in r["prompt"] or OFF_RULE in r["prompt"] for r in res.records if r["role"].startswith("buyer"))
+
+
+def test_WO_differs_from_WG_only_in_communication_lines(run_arm):
+    wg, wo = run_arm("WG", out_name="WG-x"), run_arm("WO", out_name="WO-x")
+    for rnd in range(1, 5):
+        assert seller_prompts(wg, rnd) == seller_prompts(wo, rnd)
+    allowed_removed = re.compile(r"Seller messages are now limited|Messages Received|From Seller|maximum length limit|"
+                                 r"plan_for_message|message_to_sellers|new_memory")
+    for rnd in range(5, ROUNDS + 1):
+        for role, pwg in seller_prompts(wg, rnd).items():
+            ch = changed_lines(pwg, seller_prompts(wo, rnd)[role])
+            added = [l[2:] for l in ch if l.startswith("+ ")]
+            removed = [l[2:] for l in ch if l.startswith("- ")]
+            assert all(allowed_removed.search(l) for l in removed), removed
+            assert [l for l in added if "new_memory" not in l] == [f"- {OFF_RULE}"], added
+            assert NOTICE in pwg and NOTICE in seller_prompts(wo, rnd)[role]
+
