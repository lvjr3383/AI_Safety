+def test_budget_ceiling_and_unverifiable_cost(tmp_path, monkeypatch):
+    t = spend.SpendTracker()
+    ledger = tmp_path / "ledger.jsonl"
+    ledger.write_text(json.dumps({"cost_usd": 27.97}) + "\n")
+    t.configure(ledger, 28.0, "run", tmp_path / "usage.jsonl")
+    with pytest.raises(spend.BudgetExceeded):
+        t.check_can_spend()
+    t.configure(ledger, 30.0, "run", tmp_path / "usage.jsonl")
+    resp = SimpleNamespace(model="openai/gpt-4.1", id="gen-1", model_extra={"provider": "OpenAI"},
+                           usage=SimpleNamespace(prompt_tokens=100, completion_tokens=50, prompt_tokens_details=None,
+                                                 model_extra={"cost": 0.0123}))
+    assert t.record(model_requested="openai/gpt-4.1", response=resp) == pytest.approx(0.0123)
+    assert t.total_usd == pytest.approx(27.97 + 0.0123)
+    monkeypatch.setattr(t, "_price_table", lambda: {})
+    resp.usage.model_extra = {}
+    with pytest.raises(spend.SpendUnverifiable):
+        t.record(model_requested="openai/gpt-4.1", response=resp)
+    lines = [json.loads(l) for l in ledger.read_text().splitlines()]
+    assert lines[-1]["cost_source"] == "unverifiable" and lines[-2]["cost_usd"] == pytest.approx(0.0123)
