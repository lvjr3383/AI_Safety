diff --git a/llm-agent-collusion/src/resources/spend.py b/llm-agent-collusion/src/resources/spend.py
new file mode 100644
index 0000000..4840e60
--- /dev/null
+++ b/llm-agent-collusion/src/resources/spend.py
@@ -0,0 +1,177 @@
+"""
+Sprint 3.4 (Phase 2): per-call cost accounting, a cumulative project spending ceiling, and a provider guard.
+
+- Every billed model response is appended to a project-wide JSONL ledger (shared by all runs) and to the run's
+  own usage.jsonl. Cost comes from OpenRouter's usage accounting (`usage.cost`); if that is missing it falls
+  back to OpenRouter's published per-token prices; if neither is available the call is refused afterwards
+  (SpendUnverifiable) so the run stops instead of spending blind.
+- Before every call, `check_can_spend` refuses (BudgetExceeded) if ledger total + a per-call reserve would pass
+  the ceiling.
+- `assert_openrouter_only` refuses to run if any setting could route calls somewhere other than OpenRouter.
+None of these errors are ValueErrors, so the agents' retry decorators never swallow them.
+"""
+
+import json
+import os
+import threading
+import urllib.request
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Optional
+
+OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"
+
+
+class BudgetExceeded(RuntimeError):
+    pass
+
+
+class SpendUnverifiable(RuntimeError):
+    pass
+
+
+class ProviderConfigError(RuntimeError):
+    pass
+
+
+def assert_openrouter_only(base_url: Optional[str] = None) -> None:
+    """Fail unless every call will go to OpenRouter with OPENROUTER_API_KEY. Never prints key values."""
+    problems = []
+    if os.environ.get("NEBIUS_API_KEY"):
+        problems.append("NEBIUS_API_KEY is set (it would route every call to Nebius)")
+    if os.environ.get("LLM_MODEL"):
+        problems.append("LLM_MODEL is set (it would force one model onto every role)")
+    if os.environ.get("LLM_BASE_URL"):
+        problems.append("LLM_BASE_URL is set (it would redirect calls)")
+    if os.environ.get("LLM_PROVIDER", "openrouter").lower() != "openrouter":
+        problems.append("LLM_PROVIDER is not 'openrouter'")
+    if not os.environ.get("OPENROUTER_API_KEY"):
+        problems.append("OPENROUTER_API_KEY is not set")
+    if base_url is not None and not str(base_url).rstrip("/").startswith(OPENROUTER_BASE_URL):
+        problems.append("client base_url is not OpenRouter")
+    if problems:
+        raise ProviderConfigError("refusing to run: " + "; ".join(problems))
+
+
+class SpendTracker:
+    """Thread-safe singleton-style tracker. Inactive (no ceiling, no files) until configure() is called."""
+
+    def __init__(self):
+        self._lock = threading.Lock()
+        self.ledger_path: Optional[Path] = None
+        self.usage_path: Optional[Path] = None
+        self.ceiling_usd: Optional[float] = None
+        self.run_id: str = ""
+        self.total_usd = 0.0  # cumulative project spend (ledger), including this run
+        self.run_usd = 0.0
+        self.run_calls = 0
+        self.max_call_usd = 0.0
+        self.models_seen: dict[str, int] = {}
+        self._prices: Optional[dict[str, tuple[float, float]]] = None
+
+    def configure(self, ledger_path: Path, ceiling_usd: float, run_id: str, usage_path: Path) -> None:
+        with self._lock:
+            self.ledger_path, self.usage_path = Path(ledger_path), Path(usage_path)
+            self.ceiling_usd, self.run_id = ceiling_usd, run_id
+            self.ledger_path.parent.mkdir(parents=True, exist_ok=True)
+            self.total_usd = 0.0
+            if self.ledger_path.exists():
+                for line in self.ledger_path.read_text().splitlines():
+                    if line.strip():
+                        c = float(json.loads(line).get("cost_usd") or 0.0)
+                        self.total_usd += c
+                        self.max_call_usd = max(self.max_call_usd, c)
+            self.run_usd, self.run_calls, self.models_seen = 0.0, 0, {}
+
+    @property
+    def active(self) -> bool:
+        return self.ledger_path is not None
+
+    def call_reserve(self) -> float:
+        return max(0.05, 1.5 * self.max_call_usd)
+
+    def check_can_spend(self, n_calls: int = 1) -> None:
+        if not self.active or self.ceiling_usd is None:
+            return
+        with self._lock:
+            need = self.total_usd + n_calls * self.call_reserve()
+            if need > self.ceiling_usd:
+                raise BudgetExceeded(
+                    f"spend ceiling ${self.ceiling_usd:.2f} would be exceeded: spent ${self.total_usd:.4f}, "
+                    f"reserve for {n_calls} call(s) ${n_calls * self.call_reserve():.4f}"
+                )
+
+    def _price_table(self) -> dict[str, tuple[float, float]]:
+        if self._prices is None:
+            try:
+                with urllib.request.urlopen(OPENROUTER_BASE_URL + "/models", timeout=20) as r:
+                    data = json.load(r).get("data", [])
+                self._prices = {
+                    m["id"]: (float(m["pricing"]["prompt"]), float(m["pricing"]["completion"]))
+                    for m in data
+                    if m.get("pricing")
+                }
+            except Exception:
+                self._prices = {}
+        return self._prices
+
+    def record(self, *, model_requested: str, response: Any = None, error: Optional[str] = None,
+               latency_s: float = 0.0, role: str = "") -> float:
+        """Record one API attempt. Returns its cost in USD. Raises SpendUnverifiable if a billed response has no
+        verifiable cost."""
+        if not self.active:
+            return 0.0
+        rec: dict[str, Any] = {
+            "ts": datetime.now().isoformat(), "run_id": self.run_id, "role": role,
+            "model_requested": model_requested, "latency_s": round(latency_s, 3), "error": error,
+        }
+        cost = 0.0
+        if response is not None:
+            usage = getattr(response, "usage", None)
+            extra = (getattr(usage, "model_extra", None) or {}) if usage is not None else {}
+            resp_extra = getattr(response, "model_extra", None) or {}
+            pt = getattr(usage, "prompt_tokens", None) if usage is not None else None
+            ct = getattr(usage, "completion_tokens", None) if usage is not None else None
+            details = getattr(usage, "prompt_tokens_details", None) if usage is not None else None
+            rec.update({
+                "model_returned": getattr(response, "model", None),
+                "provider": resp_extra.get("provider"),
+                "generation_id": getattr(response, "id", None),
+                "prompt_tokens": pt, "completion_tokens": ct,
+                "cached_tokens": getattr(details, "cached_tokens", None) if details is not None else None,
+            })
+            if extra.get("cost") is not None:
+                cost, rec["cost_source"] = float(extra["cost"]), "openrouter_usage"
+            else:
+                price = self._price_table().get(model_requested)
+                if price is None or pt is None or ct is None:
+                    rec["cost_usd"], rec["cost_source"] = None, "unverifiable"
+                    self._write(rec)
+                    raise SpendUnverifiable(f"no cost for a billed {model_requested} response; stopping")
+                cost, rec["cost_source"] = pt * price[0] + ct * price[1], "price_table_estimate"
+        rec["cost_usd"] = cost
+        with self._lock:
+            self.total_usd += cost
+            self.run_usd += cost
+            self.run_calls += 1 if response is not None else 0
+            self.max_call_usd = max(self.max_call_usd, cost)
+            if rec.get("model_returned"):
+                self.models_seen[rec["model_returned"]] = self.models_seen.get(rec["model_returned"], 0) + 1
+            self._write(rec)
+        return cost
+
+    def _write(self, rec: dict[str, Any]) -> None:
+        line = json.dumps(rec) + "\n"
+        for p in (self.ledger_path, self.usage_path):
+            with open(p, "a", encoding="utf-8") as f:
+                f.write(line)
+
+    def summary(self) -> dict[str, Any]:
+        return {
+            "run_cost_usd": round(self.run_usd, 6), "run_billed_calls": self.run_calls,
+            "project_total_usd": round(self.total_usd, 6), "ceiling_usd": self.ceiling_usd,
+            "models_returned": dict(self.models_seen),
+        }
+
+
+TRACKER = SpendTracker()
