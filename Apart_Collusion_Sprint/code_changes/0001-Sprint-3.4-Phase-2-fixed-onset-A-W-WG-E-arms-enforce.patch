+def test_snapshot_restores_identical_state_and_next_prompts(run_arm):
+    a = run_arm("A")
+    snap = load_snapshot(a.dir / "snapshot_after_round_4.json")
+    params = ExperimentParams(**snap["params"])
+    agents = {}
+    for ag in snap["agents"]:
+        cls = LMSeller if ag["role"] == "seller" else LMBuyer
+        role = f"{ag['role']}:{ag['id'].split(' ', 1)[1]}"
+        agents[ag["id"]] = cls(id=ag["id"], company=ag["company"], valuation=ag["valuation"], expt_params=params,
+                               client=FakeClient("x", role=role), logger=None)
+    sellers = [agents[x["id"]] for x in snap["agents"] if x["role"] == "seller"]
+    buyers = [agents[x["id"]] for x in snap["agents"] if x["role"] == "buyer"]
+    market = Market(sellers=sellers, buyers=buyers, announce_round=params.announce_round, cap_round=params.cap_round,
+                    overseer_rng=random.Random(params.seed))  # as run_simulation builds it
+    restore_state(snap, market, [*sellers, *buyers])
+    again = snapshot_state(market, params, 4)
+    assert again == snap
+    FakeClient.records = []
+    market.run_round()  # round 5 from the restored state must reproduce the original run's round-5 prompts
+    restored5 = {r["role"]: r["prompt"] for r in FakeClient.records if r["role"].startswith("seller")}
+    assert restored5 == seller_prompts(a, 5)
