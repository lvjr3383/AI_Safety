+++ b/llm-agent-collusion/src/continuous_double_auction/snapshot.py
@@ -0,0 +1,100 @@
+"""
+Sprint 3.4 (Phase 2): save / restore the complete market + agent state after a round, so the A/W/WG arms
+can later branch from one shared pre-treatment history.
+
+A snapshot holds everything that determines the next prompts: the market history (rounds, order books,
+past trades, gag flag), each LLM agent's memory and scratchpad, and the Python / NumPy / overseer RNG
+states. Model clients are NOT stored; they are rebuilt from the params when restoring.
+"""
+
+import json
+import random
+from pathlib import Path
+from typing import Any, Sequence
+
+import numpy as np
+
+from src.continuous_double_auction.cda_types import ExperimentParams, MarketRound, Trade
+from src.continuous_double_auction.market.market import Market
+
+SNAPSHOT_VERSION = 1
+
+
+def _agent_state(agent, role: str) -> dict[str, Any]:
+    mm = getattr(agent, "memory_manager", None)
+    return {
+        "id": agent.id,
+        "role": role,
+        "company": agent.company,
+        "valuation": agent.valuation,
+        "memories": {str(k): v for k, v in (mm.memories.items() if mm else [])},
+        "scratch_pad": getattr(agent, "scratch_pad", None),
+    }
+
+
+def snapshot_state(market: Market, params: ExperimentParams, after_round: int) -> dict[str, Any]:
+    """Serialise the full state at the end of `after_round` (i.e. before round after_round+1 starts)."""
+    np_state = np.random.get_state()
+    py_state = random.getstate()
+    return {
+        "snapshot_version": SNAPSHOT_VERSION,
+        "snapshot_after_round": after_round,
+        "params": params.model_dump(),
+        "market": {
+            "rounds": [r.model_dump() for r in market.rounds],
+            "current_round": market.current_round.model_dump(),
+            "seller_ask_queue": [list(x) for x in market.seller_ask_queue],
+            "buyer_bid_queue": [list(x) for x in market.buyer_bid_queue],
+            "past_trades": [t.model_dump() for t in market.past_trades],
+            "is_gag_order_active": market.is_gag_order_active,
+        },
+        "agents": [_agent_state(s, "seller") for s in market.sellers] + [_agent_state(b, "buyer") for b in market.buyers],
+        "rng": {
+            "python": [py_state[0], list(py_state[1]), py_state[2]],
+            "numpy": [np_state[0], np_state[1].tolist(), int(np_state[2]), int(np_state[3]), float(np_state[4])],
+            "overseer": (lambda s: [s[0], list(s[1]), s[2]])(market.overseer_rng.getstate()) if market.overseer_rng else None,
+        },
+    }
+
+
+def save_snapshot(snapshot: dict[str, Any], path: Path) -> None:
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(snapshot, f, indent=1, ensure_ascii=False)
+
+
+def load_snapshot(path: Path) -> dict[str, Any]:
+    with open(path, encoding="utf-8") as f:
+        snap = json.load(f)
+    if snap.get("snapshot_version") != SNAPSHOT_VERSION:
+        raise ValueError(f"unsupported snapshot version {snap.get('snapshot_version')}")
+    return snap
+
+
+def restore_state(snapshot: dict[str, Any], market: Market, agents: Sequence) -> None:
+    """Load a snapshot into a freshly built market whose agents have the same ids (clients already attached)."""
+    m = snapshot["market"]
+    market.rounds = [MarketRound(**r) for r in m["rounds"]]
+    market.current_round = MarketRound(**m["current_round"])
+    market.seller_ask_queue = [tuple(x) for x in m["seller_ask_queue"]]
+    market.buyer_bid_queue = [tuple(x) for x in m["buyer_bid_queue"]]
+    market.past_trades = [Trade(**t) for t in m["past_trades"]]
+    market.is_gag_order_active = m["is_gag_order_active"]
+
+    by_id = {a["id"]: a for a in snapshot["agents"]}
+    if set(by_id) != {a.id for a in agents}:
+        raise ValueError("snapshot agent ids do not match the market's agents")
+    for agent in agents:
+        a = by_id[agent.id]
+        if agent.company != a["company"] or agent.valuation != a["valuation"]:
+            raise ValueError(f"agent {agent.id} company/valuation differs from the snapshot")
+        if getattr(agent, "memory_manager", None) is not None:
+            agent.memory_manager.memories = {int(k): v for k, v in a["memories"].items()}
+        if a["scratch_pad"] is not None and hasattr(agent, "scratch_pad"):
+            agent.scratch_pad = a["scratch_pad"]
+
+    rng = snapshot["rng"]
+    random.setstate((rng["python"][0], tuple(rng["python"][1]), rng["python"][2]))
+    n = rng["numpy"]
+    np.random.set_state((n[0], np.array(n[1], dtype=np.uint32), n[2], n[3], n[4]))
+    if rng["overseer"] is not None and market.overseer_rng is not None:
+        market.overseer_rng.setstate((rng["overseer"][0], tuple(rng["overseer"][1]), rng["overseer"][2]))
