+# ---- crossed-model follow-up: Sonnet sellers (direct Anthropic) + GPT-4.1-mini buyers (OpenRouter) ----
+def test_mixed_crossed_buyer_config_identical_to_gpt_study(monkeypatch):
+    from src.continuous_double_auction.util.misc import get_client
+    from src.resources.model_wrappers import OpenRouterClient
+
+    monkeypatch.setenv("OPENROUTER_API_KEY", "test-dummy")
+    monkeypatch.setenv("ANTHROPIC_API_KEY", "test-dummy")
+    for v in ("NEBIUS_API_KEY", "LLM_MODEL", "LLM_BASE_URL", "ANTHROPIC_BASE_URL"):
+        monkeypatch.delenv(v, raising=False)
+
+    def snap(c):
+        return {"cls": type(c).__name__, "model": c.model_name, "temperature": c.temperature, "max_tokens": c.max_tokens,
+                "top_p": c.top_p, "params": dict(c.additional_params), "base_url": str(c.client.base_url)}
+
+    monkeypatch.setenv("LLM_PROVIDER", "openrouter")
+    gpt_study = snap(get_client(model="gpt-4.1-mini", temperature=0.7, seed=3, role="buyer:X"))
+    monkeypatch.setenv("LLM_PROVIDER", "mixed_crossed")
+    crossed = snap(get_client(model="gpt-4.1-mini", temperature=0.7, seed=3, role="buyer:X"))
+    assert crossed == gpt_study
+    assert gpt_study["cls"] == "OpenRouterClient" and gpt_study["model"] == "openai/gpt-4.1-mini"
+    assert gpt_study["temperature"] == 0.7 and gpt_study["params"] == {"seed": 3, "response_format": {"type": "json_object"}}
+    seller = get_client(model="claude-sonnet-5-5", temperature=0.7, seed=3, role="seller:Y", sdk_client=object())
+    assert type(seller).__name__ == "AnthropicDirectClient" and seller.config["thinking"] == {"type": "between_tools"}
+    assert not isinstance(seller, OpenRouterClient)
