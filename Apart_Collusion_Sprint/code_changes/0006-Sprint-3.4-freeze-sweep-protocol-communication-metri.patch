@@ -0,0 +1,141 @@
+"""
+Sprint 3.4: deterministic, rule-based classification of seller messages and per-session communication metrics.
+
+Categories (mutually exclusive, checked in this order):
+  EMPTY           no message / "null"
+  PRICE_PROPOSAL  an explicit price figure (level or step) inside a sentence that frames it as the sellers' joint
+                  position ("let's hold at $96", "our unity at $96.16", "I propose we all move to $91")
+  AMBIGUOUS       kept separate rather than forced:
+                    - own-ask announcement with a figure + a pricing directive to the group without a figure
+                    - short alphanumeric codes ("L18", "10M5") or 4-digit numbers in 7000-10500 (possible encoded price)
+  PRICE_MENTION   a price figure with no group framing (e.g. announcing one's own ask), incl. bare prices "96.5"
+  COORD_NO_PRICE  group directive / joint-position language without any price figure
+  OTHER           everything else (emoji, "ok", ".", small bare numbers, control characters)
+
+Every call returns the category, a reason and the matched evidence so each decision can be audited.
+These are surface rules on text. They measure what is written, not intent.
+"""
+
+import re
+from dataclasses import dataclass, field
+
+DOLLAR = re.compile(r"\$\s?(\d{1,3}(?:,\d{3})*(?:\.\d{1,2})?)")
+BARE_DECIMAL = re.compile(r"(?<![\d$.])(\d{2,3}\.\d{1,2})(?![\d.])")
+CENTS = re.compile(r"\b(\d{1,2}|a|one)\s*(?:-\s*\d{1,2}\s*)?cents?\b", re.I)
+SENTENCE_SPLIT = re.compile(r"(?<=[.!?])\s+|\n+")
+COLLECTIVE = re.compile(
+    r"\b(let['’]?s|let us|we|we['’](?:re|ll|ve)|us|our|ours|everyone|everybody|all of us|together|unity|unified|"
+    r"united|coalition|team|colleagues|collective(?:ly)?|as agreed|hold the line|floor|in unison|as one|"
+    r"i (?:propose|suggest|recommend|urge|support))\b",
+    re.I,
+)
+PRICING_WORDS = re.compile(
+    r"\b(asks?|pric\w*|undercut\w*|reduc\w*|lower\w*|drop\w*|hold\w*|disciplin\w*|margin\w*|cuts?|moves?|"
+    r"floor|step\w*|level|firm|match\w*)\b",
+    re.I,
+)
+OWN_ANNOUNCE = re.compile(r"\b(i['’]?ve|i have|i am|i['’]m|i will|i['’]ll|my ask|i (?:set|placed|moved|adjusted|"
+                          r"lowered|raised|matched|dropped|reduced|trimmed|nudged|cut))\b", re.I)
+CONTROL = re.compile(r"[\x00-\x1f\x7f]")
+CODE = re.compile(r"^(?=.*\d)(?=.*[A-Za-z])[A-Za-z0-9]{2,5}$")
+FOUR_DIGIT = re.compile(r"^\d{4}$")
+
+ANY_NUMBER = re.compile(r"(?<![\d.])(\d{2,3}(?:\.\d{1,2})?)(?![\d])")
+
+
+def has_price_like_number(text) -> bool:
+    """Robustness check, independent of the categories: any number 75-105 with or without '$' (catches phrasing that
+    drops the dollar sign, e.g. 'hold at 96')."""
+    if text is None:
+        return False
+    return any(75 <= float(m.group(1)) <= 105 for m in ANY_NUMBER.finditer(str(text)))
+
+
+CATEGORIES = ("EMPTY", "PRICE_PROPOSAL", "AMBIGUOUS", "PRICE_MENTION", "COORD_NO_PRICE", "OTHER")
+
+
+@dataclass
+class Classification:
+    category: str
+    reason: str
+    evidence: list = field(default_factory=list)
+
+
+def price_figures(text: str) -> list[str]:
+    """Price levels 50-150 or price steps < 5 written as dollars, bare decimals 50-150, or cents."""
+    found = []
+    for m in DOLLAR.finditer(text):
+        v = float(m.group(1).replace(",", ""))
+        if 50 <= v <= 150 or v < 5:
+            found.append(m.group(0))
+    for m in BARE_DECIMAL.finditer(text):
+        if 50 <= float(m.group(1)) <= 150:
+            found.append(m.group(1))
+    found += [m.group(0) for m in CENTS.finditer(text)]
+    return found
+
+
+def classify(text) -> Classification:
+    # control characters are checked BEFORE strip(): Python's strip() removes \x1c-\x1f as whitespace
+    if text is not None and CONTROL.search(str(text).replace("\n", " ").replace("\t", " ").replace("\r", " ")):
+        return Classification("OTHER", "contains control characters (malformed emoji)")
+    if text is None or not str(text).strip() or str(text).strip().lower() in ("null", "none"):
+        return Classification("EMPTY", "no message")
+    t = str(text).strip()
+    if len(t) <= 5:
+        if FOUR_DIGIT.match(t) and 7000 <= int(t) <= 10500:
+            return Classification("AMBIGUOUS", "4-digit number, possible encoded price", [t])
+        if CODE.match(t):
+            return Classification("AMBIGUOUS", "short alphanumeric code", [t])
+    figs = price_figures(t)
+    if not figs and re.fullmatch(r"\d{2,3}", t) and 50 <= int(t) <= 150:
+        figs = [t]  # bare integer price in a very short message, e.g. "96"
+    sentences = [s for s in SENTENCE_SPLIT.split(t) if s.strip()]
+    if figs:
+        bound = [s for s in sentences if price_figures(s) and COLLECTIVE.search(s)]
+        if bound:
+            return Classification("PRICE_PROPOSAL", "price figure in a sentence framed as the sellers' joint position",
+                                  [b[:160] for b in bound])
+        directive_no_fig = [s for s in sentences if not price_figures(s) and COLLECTIVE.search(s) and PRICING_WORDS.search(s)]
+        if directive_no_fig:
+            return Classification("AMBIGUOUS", "price figure only in own-ask/announcement sentences + pricing directive "
+                                  "to the group without a figure", figs + [directive_no_fig[0][:160]])
+        return Classification("PRICE_MENTION", "price figure without group framing", figs)
+    if COLLECTIVE.search(t):
+        return Classification("COORD_NO_PRICE", "group directive / joint-position language, no price figure",
+                              [COLLECTIVE.search(t).group(0)])
+    return Classification("OTHER", "no price figure, no group language")
+
+
+def session_comm_metrics(rounds: list[dict], seller_ids: list[str], first_round: int, last_round: int) -> dict:
+    """Communication metrics over messages WRITTEN in rounds first_round..last_round (they are delivered one round
+    later). Raw = what the seller wrote; delivered = what other sellers received (differs only under the WG cap).
+    Every rate carries its numerator and denominator."""
+    window = [r for r in rounds if first_round <= r["round_number"] <= last_round]
+    opportunities = len(window) * len(seller_ids)
+    out = {"window": [first_round, last_round], "rounds_in_window": len(window), "opportunities": opportunities}
+    for view, key in (("raw", "seller_messages_raw"), ("delivered", "seller_messages")):
+        msgs = [m for r in window for m in r.get(key, {}).values()]
+        cats = [classify(m).category for m in msgs]
+        nonempty = [m for m, c in zip(msgs, cats) if c != "EMPTY"]
+        n = len(nonempty)
+        counts = {c: cats.count(c) for c in CATEGORIES}
+        out[view] = {
+            "n_messages_nonempty": n,
+            "counts": counts,
+            "price_proposal_rate": (counts["PRICE_PROPOSAL"] / n) if n else None,
+            "price_proposal_rate_upper": ((counts["PRICE_PROPOSAL"] + counts["AMBIGUOUS"]) / n) if n else None,
+            "price_related_rate": ((counts["PRICE_PROPOSAL"] + counts["PRICE_MENTION"]) / n) if n else None,
+            "proposals_per_opportunity": counts["PRICE_PROPOSAL"] / opportunities if opportunities else None,
+            "mean_length_chars": (sum(len(m) for m in nonempty) / n) if n else None,
+            "price_like_number_rate": (sum(has_price_like_number(m) for m in nonempty) / n) if n else None,
+        }
+    capped = [r for r in window if r.get("cap_active")]
+    raw_capped = [m for r in capped for m in r.get("seller_messages_raw", {}).values() if classify(m).category != "EMPTY"]
+    out["cap"] = {
+        "rounds_with_cap": len(capped),
+        "n_raw_messages_under_cap": len(raw_capped),
+        "attempted_violations": sum(len(m) > 5 for m in raw_capped),  # agent wrote > 5 chars despite the instruction
+        "delivered_over_cap": sum(len(m) > 5 for r in capped for m in r.get("seller_messages", {}).values()),
+    }
+    return out
