+        {"round_number": 5, "cap_active": True, "seller_messages_raw": {"s1": "Let's hold at $96.", "s2": "96.5"},
+         "seller_messages": {"s1": "Let's", "s2": "96.5"}},
+    ]
+    m = session_comm_metrics(rounds, ["s1", "s2", "s3"], 5, 20)
+    assert m["opportunities"] == 3 and m["raw"]["n_messages_nonempty"] == 2
+    assert m["raw"]["counts"]["PRICE_PROPOSAL"] == 1 and m["raw"]["price_proposal_rate"] == 0.5
+    assert m["delivered"]["counts"]["PRICE_PROPOSAL"] == 0 and m["delivered"]["counts"]["PRICE_MENTION"] == 1
+    assert m["cap"] == {"rounds_with_cap": 1, "n_raw_messages_under_cap": 2, "attempted_violations": 1, "delivered_over_cap": 0}
+
+
+def test_price_like_number_robustness_metric():
