@@ -0,0 +1,197 @@
+"""
+Phase 4 offline tests (no network): the direct Anthropic client is exercised against a mocked SDK object, and the
+WON arm (messaging off from round 5, NO announcement) through the real run_simulation path with the fake model.
+"""
+
+import json
+import re
+from types import SimpleNamespace
+
+import anthropic
+import httpx
+import pytest
+
+import src.continuous_double_auction.simulation as sim
+from src.resources import spend
+from src.resources.anthropic_client import (REFUSAL_JSON, AnthropicDirectClient, PriceTableError,
+                                            assert_anthropic_only, call_cost)
+from test_sprint34 import (MSG_SECTION, NOTICE, OFF_RULE, ROUNDS, FakeClient, changed_lines,  # noqa: F401
+                           make_params, run_arm, seller_prompts)
+
+
+class FakeRaw:
+    def __init__(self, resp, headers=None):
+        self._resp, self.headers = resp, headers or {"request-id": "req_test", "anthropic-ratelimit-requests-limit": "1000"}
+
+    def parse(self):
+        return self._resp
+
+
+class FakeSDK:
+    """Mimics client.messages.with_raw_response.create; returns queued responses or raises queued exceptions."""
+
+    def __init__(self, outcomes):
+        self.outcomes, self.calls = list(outcomes), []
+        self.messages = SimpleNamespace(with_raw_response=SimpleNamespace(create=self._create))
+
+    def _create(self, **kw):
+        self.calls.append(kw)
+        o = self.outcomes.pop(0)
+        if isinstance(o, Exception):
+            raise o
+        return FakeRaw(o)
+
+
+def resp(text='{"ask": 96.5}', stop="end_turn", model="claude-sonnet-5-5", it=2000, ot=400):
+    return SimpleNamespace(model=model, id="msg_1", stop_reason=stop, stop_details=None,
+                           content=[SimpleNamespace(type="text", text=text)],
+                           usage=SimpleNamespace(input_tokens=it, output_tokens=ot, cache_read_input_tokens=0,
+                                                 cache_creation_input_tokens=0))
+
+
+@pytest.fixture
+def tracker(tmp_path, monkeypatch):
+    t = spend.SpendTracker()
+    t.configure(tmp_path / "ledger.jsonl", 60.0, "test", tmp_path / "usage.jsonl")
+    monkeypatch.setattr("src.resources.anthropic_client.TRACKER", t)
+    monkeypatch.setenv("ANTHROPIC_API_KEY", "test-dummy")
+    for v in ("LLM_MODEL", "LLM_BASE_URL", "ANTHROPIC_BASE_URL"):
+        monkeypatch.delenv(v, raising=False)
+    return t
+
+
+def ledger(t):
+    return [json.loads(l) for l in t.ledger_path.read_text().splitlines()]
+
+
+@pytest.mark.parametrize("model,thinking,effort", [("claude-sonnet-5-5", {"type": "between_tools"}, "high"),
+                                                   ("claude-haiku-5-5", {"type": "disabled"}, "medium")])
+def test_request_construction_per_model(tracker, model, thinking, effort):
+    sdk = FakeSDK([resp(model=model)])
+    c = AnthropicDirectClient(model, role="seller:X", sdk_client=sdk, temperature=0.7, seed=3,
+                              response_format={"type": "json_object"})
+    assert c.generate([{"role": "user", "content": "hi"}]) == '{"ask": 96.5}'
+    kw = sdk.calls[0]
+    assert kw["model"] == model and kw["max_tokens"] == 4000 and kw["thinking"] == thinking
+    assert kw["output_config"] == {"effort": effort}
+    assert not {"temperature", "top_p", "top_k", "seed", "response_format", "system"} & set(kw)
+    rec = ledger(tracker)[0]
+    assert rec["model_returned"] == model and rec["thinking"] == thinking and rec["stop_reason"] == "end_turn"
+    assert rec["content_block_types"] == ["text"] and rec["provider"] == "anthropic_direct"
+
+
+def test_cost_arithmetic(tracker):
+    assert call_cost("claude-sonnet-5-5", {"input_tokens": 2000, "output_tokens": 400, "cache_read_input_tokens": 0,
+                                           "cache_creation_input_tokens": 0}) == pytest.approx(2000 * 2e-6 + 400 * 10e-6)
+    assert call_cost("claude-haiku-5-5", {"input_tokens": 2000, "output_tokens": 400, "cache_read_input_tokens": 0,
+                                          "cache_creation_input_tokens": 0}) == pytest.approx(2000 * 0.1e-6 + 400 * 0.5e-6)
+    with pytest.raises(PriceTableError):
+        call_cost("claude-haiku-5-5", {"input_tokens": 100_001, "output_tokens": 1, "cache_read_input_tokens": 0,
+                                       "cache_creation_input_tokens": 0})
+
+
+def test_refusal_recorded_not_retried(tracker):
+    sdk = FakeSDK([resp(stop="refusal", text="")])
+    c = AnthropicDirectClient("claude-sonnet-5-5", sdk_client=sdk)
+    assert c.generate([{"role": "user", "content": "x"}]) == REFUSAL_JSON
+    assert len(sdk.calls) == 1 and ledger(tracker)[0]["stop_reason"] == "refusal"
+
+
+def _err(cls, status, body):
+    r = httpx.Response(status, request=httpx.Request("POST", "https://api.anthropic.com/v1/messages"), json=body)
+    return cls(message=json.dumps(body), response=r, body=body)
+
+
+def test_spend_cap_and_bad_request_fail_closed(tracker):
+    cap = _err(anthropic.RateLimitError, 429, {"error": {"type": "rate_limit_error", "message": "cap",
+                                                         "details": {"error_code": "enforced_spend_limit_reached"}}})
+    with pytest.raises(spend.BudgetExceeded):
+        AnthropicDirectClient("claude-sonnet-5-5", sdk_client=FakeSDK([cap])).generate([{"role": "user", "content": "x"}])
+    bad = _err(anthropic.BadRequestError, 400, {"error": {"type": "invalid_request_error", "message": "thinking.type"}})
+    with pytest.raises(spend.ProviderConfigError):
+        AnthropicDirectClient("claude-haiku-5-5", sdk_client=FakeSDK([bad])).generate([{"role": "user", "content": "x"}])
+
+
+def test_transient_errors_retried_then_succeed(tracker, monkeypatch):
+    monkeypatch.setattr(AnthropicDirectClient, "_exponential_backoff", lambda self, a: None)
+    rl = _err(anthropic.RateLimitError, 429, {"error": {"type": "rate_limit_error", "message": "slow down"}})
+    sdk = FakeSDK([rl, resp()])
+    assert AnthropicDirectClient("claude-sonnet-5-5", sdk_client=sdk).generate([{"role": "user", "content": "x"}])
+    recs = ledger(tracker)
