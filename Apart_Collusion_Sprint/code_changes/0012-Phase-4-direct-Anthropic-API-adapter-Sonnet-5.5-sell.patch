+    def record_external(self, *, model_requested: str, cost: float, role: str = "", latency_s: float = 0.0,
+                        error: Optional[str] = None, **fields: Any) -> float:
+        """Phase 4 (direct Anthropic API): record one attempt whose cost the caller computed from token usage and a
+        verified price table. Billed responses pass prompt_tokens; failed attempts pass error and cost 0."""
+        if not self.active:
+            return 0.0
+        rec: dict[str, Any] = {"ts": datetime.now().isoformat(), "run_id": self.run_id, "role": role,
+                               "model_requested": model_requested, "latency_s": round(latency_s, 3), "error": error,
+                               **fields, "cost_usd": cost}
+        with self._lock:
+            self.total_usd += cost
+            self.run_usd += cost
+            self.run_calls += 1 if fields.get("prompt_tokens") is not None else 0
+            self.max_call_usd = max(self.max_call_usd, cost)
+            if fields.get("model_returned"):
+                self.models_seen[fields["model_returned"]] = self.models_seen.get(fields["model_returned"], 0) + 1
+            self._write(rec)
+        return cost
+
     def _write(self, rec: dict[str, Any]) -> None:
         line = json.dumps(rec) + "\n"
         for p in (self.ledger_path, self.usage_path):
