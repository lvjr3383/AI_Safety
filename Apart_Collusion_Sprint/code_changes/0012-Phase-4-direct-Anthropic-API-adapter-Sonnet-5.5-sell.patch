diff --git a/llm-agent-collusion/src/resources/anthropic_client.py b/llm-agent-collusion/src/resources/anthropic_client.py
new file mode 100644
index 0000000..3a094d5
--- /dev/null
+++ b/llm-agent-collusion/src/resources/anthropic_client.py
@@ -0,0 +1,134 @@
+"""
+Phase 4: direct Anthropic API client (native `anthropic` SDK). Isolated from the OpenRouter path used by the
+GPT-4.1 study, which is unchanged.
+
+- No sampling parameters are sent (temperature/top_p/top_k): Sonnet 5.5 and Haiku 5.5 reject non-default values,
+  so both run at their default sampling. Documented as a difference from the GPT-4.1 runs (T=0.7).
+- Thinking is configured per model, explicitly (MODEL_CONFIG); no server-side fallbacks, no model substitution.
+- Every attempt is recorded in the spend ledger with the effective model id, thinking/effort config, stop_reason,
+  token usage, request id and rate-limit headers. Cost = tokens x the price table verified 2026-10-24.
+- Refusals (stop_reason == "refusal") are NOT retried: the call returns REFUSAL_JSON, which the agents treat as a
+  no-action turn (no new ask/bid, no message, no memory update), identically in every arm.
+"""
+
+import json
+import os
+import time
+from typing import List, Optional
+
+from src.resources.model_wrappers import Message, ModelWrapper
+from src.resources.spend import TRACKER, BudgetExceeded, ProviderConfigError
+
+# Thinking/effort per model. Sonnet 5.5: `disabled` returns 400; `between_tools` turns thinking off (no tools are
+# used here) and is accepted at effort <= high. Haiku 5.5: `disabled` is accepted at effort <= high.
+MODEL_CONFIG = {
+    "claude-sonnet-5-5": {"thinking": {"type": "between_tools"}, "output_config": {"effort": "high"}},
+    "claude-haiku-5-5": {"thinking": {"type": "disabled"}, "output_config": {"effort": "medium"}},
+}
+# USD per token, from https://platform.claude.com/docs/en/about-claude/pricing (fetched 2026-10-24).
+# Haiku 5.5 prices apply to prompts up to 100,000 tokens; longer prompts raise PriceTableError (never expected here).
+PRICES = {
+    "claude-sonnet-5-5": {"input": 2.00e-6, "output": 10.00e-6, "cache_write": 2.50e-6, "cache_read": 0.10e-6},
+    "claude-haiku-5-5": {"input": 0.10e-6, "output": 0.50e-6, "cache_write": 0.125e-6, "cache_read": 0.01e-6},
+}
+HAIKU_LONG_PROMPT = 100_000
+REFUSAL_JSON = '{"refused": true}'
+RATE_HEADERS = ("anthropic-ratelimit-requests-limit", "anthropic-ratelimit-requests-remaining",
+                "anthropic-ratelimit-input-tokens-limit", "anthropic-ratelimit-output-tokens-limit")
+
+
+class PriceTableError(RuntimeError):
+    pass
+
+
+def assert_anthropic_only(model_name: str) -> None:
+    """Fail unless this call goes to the direct Anthropic API with a configured Claude model. Never prints keys."""
+    problems = []
+    if not os.environ.get("ANTHROPIC_API_KEY"):
+        problems.append("ANTHROPIC_API_KEY is not set")
+    if model_name not in MODEL_CONFIG:
+        problems.append(f"model {model_name!r} is not one of the configured Phase 4 models {sorted(MODEL_CONFIG)}")
+    for var in ("LLM_MODEL", "LLM_BASE_URL", "ANTHROPIC_BASE_URL"):
+        if os.environ.get(var):
+            problems.append(f"{var} is set (would redirect or override the model)")
+    if problems:
+        raise ProviderConfigError("refusing to run: " + "; ".join(problems))
+
+
+def call_cost(model: str, usage: dict) -> float:
+    p = PRICES[model]
+    prompt_len = usage["input_tokens"] + usage["cache_read_input_tokens"] + usage["cache_creation_input_tokens"]
+    if model == "claude-haiku-5-5" and prompt_len > HAIKU_LONG_PROMPT:
+        raise PriceTableError("Haiku prompt over 100k tokens: long-context prices not in the table")
+    return (usage["input_tokens"] * p["input"] + usage["output_tokens"] * p["output"]
+            + usage["cache_creation_input_tokens"] * p["cache_write"] + usage["cache_read_input_tokens"] * p["cache_read"])
+
+
+class AnthropicDirectClient(ModelWrapper):
+    is_remote = True
+
+    def __init__(self, model_name: str, role: str = "", sdk_client=None, **kwargs):
+        kwargs.pop("seed", None)              # no seed parameter on the Messages API
+        kwargs.pop("response_format", None)   # OpenAI JSON mode; not an Anthropic parameter
+        super().__init__(model_name, **kwargs)
+        assert_anthropic_only(model_name)
+        self.role = role
+        self.config = MODEL_CONFIG[model_name]
+        if sdk_client is None:
+            import anthropic  # optional extra `providers`
+
+            sdk_client = anthropic.Anthropic(max_retries=2, timeout=120)
+        self.sdk = sdk_client
+
+    def generate(self, messages: List[Message]) -> Optional[str]:
+        import anthropic
+
+        for attempt in range(self.max_retries):
+            TRACKER.check_can_spend()
+            t0 = time.time()
+            try:
+                raw = self.sdk.messages.with_raw_response.create(
+                    model=self.model_name, max_tokens=self.max_tokens, messages=messages,
+                    thinking=self.config["thinking"], output_config=self.config["output_config"],
+                )
+                resp = raw.parse()
+                headers = {h: raw.headers.get(h) for h in RATE_HEADERS}
+            except anthropic.RateLimitError as e:
+                body = getattr(e, "body", None) or {}
+                code = ((body.get("error") or {}).get("details") or {}).get("error_code") if isinstance(body, dict) else None
+                TRACKER.record_external(model_requested=self.model_name, cost=0.0, role=self.role,
+                                        latency_s=time.time() - t0, error=f"RateLimitError {code}: {str(e)[:160]}")
+                if code == "enforced_spend_limit_reached":
+                    raise BudgetExceeded("Anthropic organisation spend cap reached") from e
+                self._exponential_backoff(attempt)
+                continue
+            except anthropic.BadRequestError as e:
+                TRACKER.record_external(model_requested=self.model_name, cost=0.0, role=self.role,
+                                        latency_s=time.time() - t0, error=f"BadRequestError: {str(e)[:200]}")
+                if "usage limits" in str(e).lower() or "credit balance" in str(e).lower():
+                    raise BudgetExceeded(f"Anthropic billing stop: {str(e)[:200]}") from e
+                raise ProviderConfigError(f"Anthropic rejected the request (fail closed): {str(e)[:300]}") from e
+            except (anthropic.APIStatusError, anthropic.APIConnectionError) as e:
+                TRACKER.record_external(model_requested=self.model_name, cost=0.0, role=self.role,
+                                        latency_s=time.time() - t0, error=f"{type(e).__name__}: {str(e)[:160]}")
+                self._exponential_backoff(attempt)
+                continue
+            u = resp.usage
+            usage = {"input_tokens": u.input_tokens or 0, "output_tokens": u.output_tokens or 0,
+                     "cache_read_input_tokens": getattr(u, "cache_read_input_tokens", 0) or 0,
+                     "cache_creation_input_tokens": getattr(u, "cache_creation_input_tokens", 0) or 0}
+            block_types = [b.type for b in resp.content]
+            TRACKER.record_external(
+                model_requested=self.model_name, cost=call_cost(self.model_name, usage), role=self.role,
+                latency_s=time.time() - t0, model_returned=resp.model, provider="anthropic_direct",
+                generation_id=getattr(resp, "id", None), request_id=raw.headers.get("request-id"),
+                prompt_tokens=usage["input_tokens"] + usage["cache_read_input_tokens"] + usage["cache_creation_input_tokens"],
+                completion_tokens=usage["output_tokens"], usage=usage, stop_reason=resp.stop_reason,
+                stop_details=json.loads(resp.stop_details.model_dump_json()) if getattr(resp, "stop_details", None) else None,
+                thinking=self.config["thinking"], output_config=self.config["output_config"],
+                content_block_types=block_types, ratelimit=headers, cost_source="anthropic_price_table_2026-10-24",
+            )
+            if resp.stop_reason == "refusal":
+                return REFUSAL_JSON  # recorded; not retried, not replaced by another model
+            return "".join(b.text for b in resp.content if b.type == "text")
+        return None
