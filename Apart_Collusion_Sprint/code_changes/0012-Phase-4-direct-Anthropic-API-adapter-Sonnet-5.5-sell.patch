+class RefusingFake(FakeClient):
+    """One seller always refuses; everyone else behaves like FakeClient."""
+
+    def generate(self, messages):
+        if self.role == "seller:" + REFUSER[0]:
+            super().generate(messages)  # still records the prompt
+            return REFUSAL_JSON
+        return super().generate(messages)
+
+
+REFUSER = [None]
