+def test_refusal_is_a_no_action_turn(tmp_path, monkeypatch):
+    monkeypatch.setitem(sim.SPEND, "ledger", tmp_path / "ledger.jsonl")
+    monkeypatch.setattr(sim, "get_client", lambda model, role="", **kw: RefusingFake(model, role=role, **kw))
+    p = make_params("A")
+    names_seed = None
+    # discover a seller name for this seed by a first run with no refuser
+    REFUSER[0] = "nobody"
+    sim.run_simulation(p, log_dir=str(tmp_path / "probe"))
+    d = next((tmp_path / "probe").iterdir())
+    names_seed = json.loads((d / "experiment_metadata.json").read_text())["seller_ids"][0]
+    REFUSER[0] = names_seed.split(" ", 1)[1]
+    sim.run_simulation(p, log_dir=str(tmp_path / "ref"))
+    d = next((tmp_path / "ref").iterdir())
+    rounds = [json.loads(b) for b in re.findall(r"````json\n(.*?)\n````", (d / "auction_results.md").read_text(), re.S)]
+    for r in rounds:
+        assert names_seed not in r["seller_messages"] and names_seed not in r["seller_messages_raw"]
+    # round 1 carries the seeded opening order; from round 2 a refusing seller posts no new ask
+    assert all(names_seed not in r["seller_asks"] for r in rounds[1:])
+    md = (d / f"{names_seed}.md").read_text()
+    assert md.count('"refused": true') == ROUNDS
